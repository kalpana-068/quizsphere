PORT=5000
# MongoDB Atlas connection string (replace username, password, and database name)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/quizsphere?retryWrites=true&w=majority
JWT_SECRET=put_a_long_random_text_here
CLIENT_URL=http://localhost:5173

# Optional: email notifications (leave empty to skip emails, the app still works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
